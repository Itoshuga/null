# Token du bot Discord, récupéré depuis le portail développeur Discord.
DISCORD_TOKEN=token_du_bot

# Identifiant de l'application Discord.
CLIENT_ID=id_du_client_discord

# Identifiant du serveur de test pour déployer rapidement les Slash Commands.
GUILD_ID=id_du_serveur_de_test

# false = déploiement serveur, true = déploiement global.
DEPLOY_COMMANDS_GLOBAL=false

# Identifiants Discord des développeurs autorisés à utiliser les commandes de développement.
# Sépare plusieurs identifiants avec une virgule.
DEVELOPER_IDS=123456789012345678

# Identifiant du projet Firebase.
FIREBASE_PROJECT_ID=id_du_projet_firebase

# Chemin vers la clé de service Firebase réelle.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
